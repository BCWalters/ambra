{
  "name": "ambra",
  "private": true,
  "license": "MIT",
  "version": "0.0.0",
  "description": "Ambra — an EPUB3 reader browser extension.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm --filter @ambra/extension run dev",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.70.0"
  }
}
