{
  "manifest_version": 3,
  "name": "Ambra EPUB Reader",
  "short_name": "Ambra",
  "description": "Read, annotate, and explore EPUBs in Chrome with a personal library, flexible reading settings, and EPUB Inspector.",
  "version": "1.0.3",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/library/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "permissions": ["unlimitedStorage", "downloads", "notifications", "storage", "alarms"],
  "host_permissions": ["*://*/*"],
  "options_page": "src/library/index.html"
}
